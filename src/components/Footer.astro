---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <img src="/readysaltedcode_red_web_logo.png" alt="readysaltedcode" class="footer-logo" />
        <p>Creative computing education technology</p>
      </div>
      <div class="footer-social">
        <a href="https://readysaltedcode.substack.com/" target="_blank" rel="noopener noreferrer">
          Substack
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} readysaltedcode. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #333;
    color: #fff;
    padding: 3rem 0 1.5rem;
    margin-top: 4rem;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #444;
  }

  .footer-brand p {
    color: #999;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer-social a {
    color: #fff;
    padding: 0.5rem 1rem;
    border: 1px solid #555;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .footer-social a:hover {
    background: #dd3333;
    border-color: #dd3333;
    color: #fff;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    text-align: center;
  }

  .footer-bottom p {
    color: #888;
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
