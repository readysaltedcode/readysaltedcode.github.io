---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Creative Computing Resources & Workshops" description="Teaching resources and workshops that bring code to life through creativity, wearables, and data">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <span class="tagline">Empowering Educators in Creative Computing</span>
        <h1>Resources & Training for <span class="accent">Creative Computing</span></h1>
        <p class="hero-text">Research-backed lesson resources and training that bring computing to life through wearables, data, and the arts. Created by educators, for educators.</p>
        <div class="hero-ctas">
          <a href="/resources" class="btn primary">Browse Resources</a>
          <a href="/workshops" class="btn secondary">Explore Training</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility Bar -->
  <section class="credibility">
    <div class="container">
      <div class="cred-items">
        <div class="cred-item">
          <span class="cred-icon">🇬🇧</span>
          <span class="cred-text">Shaped UK National Computing Curriculum</span>
        </div>
        <div class="cred-item">
          <span class="cred-icon">🌐</span>
          <span class="cred-text">IEEE Standards Contributor</span>
        </div>
        <div class="cred-item">
          <span class="cred-icon">🎓</span>
          <span class="cred-text">Cambridge PhD | Senior Lecturer</span>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Offer -->
  <section class="offerings">
    <div class="container">
      <h2>What We Offer</h2>
      <div class="offerings-grid">
        <div class="offering-card">
          <div class="offering-icon">📚</div>
          <h3>Educator Resources</h3>
          <p>Ready-to-teach lesson packs for creative computing. Everything you need to confidently deliver wearables, physical computing, and data projects.</p>
          <ul>
            <li>Complete lesson plans</li>
            <li>Student worksheets</li>
            <li>Assessment materials</li>
            <li>Video guides for educators</li>
          </ul>
          <a href="/resources" class="offering-link">View Resources &rarr;</a>
        </div>
        <div class="offering-card">
          <div class="offering-icon">🛠️</div>
          <h3>Training & Methodologies</h3>
          <p>Learn how to run creative computing activities in your school. Hackdays, wearables workshops, and more - we'll show you how.</p>
          <ul>
            <li>Hackday methodology training</li>
            <li>Wearables workshop guides</li>
            <li>Data & Dance frameworks</li>
            <li>Educator training sessions</li>
          </ul>
          <a href="/workshops" class="offering-link">Explore Training &rarr;</a>
        </div>
        <div class="offering-card">
          <div class="offering-icon">💃</div>
          <h3>datadrivendance</h3>
          <p>A proven methodology combining dance, data, and computing. Run your own data-driven performance event at your school.</p>
          <ul>
            <li>Complete event framework</li>
            <li>Session plans & resources</li>
            <li>Technical setup guides</li>
            <li>Culminating performance event</li>
          </ul>
          <a href="/datadrivendance" class="offering-link">Learn More &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Free Resources CTA -->
  <section class="free-cta">
    <div class="container">
      <div class="free-cta-content">
        <h2>Free Teaching Resources</h2>
        <p>Download free lesson samples and teaching materials to try in your classroom.</p>
        <a href="/resources" class="btn primary">Browse Free Resources</a>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="video-section">
    <div class="container">
      <h2>See Our Work</h2>
      <div class="video-container">
        <iframe
          src="https://www.youtube.com/embed/so2hyczuJ9o"
          title="readysaltedcode introduction"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about">
    <div class="container">
      <div class="about-content">
        <h2>About readysaltedcode</h2>
        <p>readysaltedcode was founded by <a href="https://www.genevievesmithnunes.me/" target="_blank" rel="noopener noreferrer">Dr. Genevieve Smith-Nunes</a>, who has shaped computing education at the highest levels. As a member of the UK Department for Education working group, she helped develop England's national computing curriculum. She has advised the Government of Antigua & Barbuda on ICT education policy and contributes to IEEE standards on age-appropriate digital services and AI ethics in education.</p>
        <p>A Senior Lecturer at the University of Roehampton with a PhD from Cambridge, Genevieve brings research-backed approaches to creative computing. Our resources combine arts, creativity, and technology to engage all learners - designed to build confidence in educators and bring computing to life in classrooms.</p>
        <div class="about-awards">
          <p><strong>Recognition & Standards Work:</strong></p>
          <p>UK Department for Education Computing Curriculum | IEEE Brain Neuroethics Framework | IEEE 2089-2021 Age-Appropriate Digital Services | Google RISE Award | Arts Council England</p>
        </div>
        <div class="about-links">
          <a href="https://www.genevievesmithnunes.me/" target="_blank" rel="noopener noreferrer" class="social-link">Academic Profile</a>
          <a href="https://readysaltedcode.substack.com/" target="_blank" rel="noopener noreferrer" class="social-link">Substack</a>
          <a href="https://www.linkedin.com/in/genevievesmithnunes/" target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="contact-cta">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <p>Whether you need resources for your classroom or want to explore training options, we're here to help.</p>
      <div class="contact-buttons">
        <a href="/resources" class="btn primary">Browse Resources</a>
        <a href="mailto:genevieve@readysaltedcode.org" class="btn secondary">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 5rem 0;
  }

  .hero-content {
    max-width: 700px;
    text-align: center;
    margin: 0 auto;
  }

  .tagline {
    display: inline-block;
    background: rgba(221, 51, 51, 0.2);
    color: #ff6b6b;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero h1 {
    color: #fff;
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .hero .accent {
    color: #dd3333;
  }

  .hero-text {
    font-size: 1.2rem;
    color: #ccc;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn.primary {
    background: #dd3333;
    color: #fff;
  }

  .btn.primary:hover {
    background: #bb2222;
  }

  .btn.secondary {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  .btn.secondary:hover {
    background: #fff;
    color: #1a1a2e;
  }

  /* Credibility */
  .credibility {
    background: #f9f9f9;
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
  }

  .cred-items {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cred-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #555;
  }

  .cred-icon {
    font-size: 1.2rem;
  }

  /* Offerings */
  .offerings {
    padding: 4rem 0;
  }

  .offerings h2 {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .offering-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 2rem;
    transition: box-shadow 0.2s;
  }

  .offering-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .offering-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .offering-card h3 {
    margin-bottom: 0.75rem;
    color: #333;
  }

  .offering-card > p {
    color: #666;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .offering-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .offering-card li {
    padding: 0.4rem 0;
    color: #666;
    font-size: 0.9rem;
    border-bottom: 1px solid #f5f5f5;
  }

  .offering-card li:before {
    content: '✓';
    color: #28a745;
    margin-right: 0.5rem;
  }

  .offering-link {
    color: #dd3333;
    font-weight: 600;
    text-decoration: none;
  }

  .offering-link:hover {
    text-decoration: underline;
  }

  /* Free CTA */
  .free-cta {
    background: #dd3333;
    color: #fff;
    padding: 3rem 0;
    text-align: center;
  }

  .free-cta h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .free-cta p {
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .free-cta .btn.primary {
    background: #fff;
    color: #dd3333;
  }

  .free-cta .btn.primary:hover {
    background: #f0f0f0;
  }

  /* Video */
  .video-section {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .video-section h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .video-container {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 56.25%;
    height: 0;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  /* About */
  .about {
    padding: 4rem 0;
  }

  .about-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .about h2 {
    margin-bottom: 1.5rem;
  }

  .about p {
    color: #555;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about-awards {
    background: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .about-awards p {
    margin: 0;
  }

  .about-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .social-link {
    color: #dd3333;
    font-weight: 500;
  }

  /* Contact CTA */
  .contact-cta {
    background: #1a1a2e;
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .contact-cta h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .contact-cta p {
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .contact-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .cred-items {
      gap: 1.5rem;
    }

    .offerings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
