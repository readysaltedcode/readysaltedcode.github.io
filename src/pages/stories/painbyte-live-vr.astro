---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="[pain]Byte Live & VR" description="[pain]Byte Live & VR - readysaltedcode story">
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/stories">Stories</a>
      </nav>
      <h1>[pain]Byte Live & VR</h1>
    </div>
  </section>

  <article class="story-content">
    <div class="container">
      <p>What an amazing Sunday evening.</p>
      <p><iframe src="https://player.vimeo.com/video/241495760" width="640" height="323" frameborder="0" allowfullscreen="allowfullscreen"></iframe></p>
      <p><a href="https://vimeo.com/241495760">painbyte VR</a> from <a href="https://vimeo.com/user73835131">Genevieve Smith-Nunes</a> on <a href="https://vimeo.com">Vimeo</a>.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 3rem 0;
  }
  .breadcrumb { margin-bottom: 1rem; }
  .breadcrumb a { color: #ccc; }
  .page-header h1 { color: #fff; margin-bottom: 0.5rem; }
  .story-content { padding: 3rem 0; }
  .story-content .container { max-width: 800px; }
  .story-content p { margin-bottom: 1.5rem; line-height: 1.8; }
  .story-content img { max-width: 100%; height: auto; margin: 1.5rem 0; border-radius: 8px; }
  .story-content a { color: #dd3333; }
  .story-content blockquote { border-left: 4px solid #dd3333; padding-left: 1.5rem; margin: 1.5rem 0; font-style: italic; color: #555; }
  .story-content strong { font-weight: 600; }
</style>
