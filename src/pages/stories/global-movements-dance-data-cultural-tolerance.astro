---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Global Movements dance, data & cultural tolerance" description="Global Movements dance, data & cultural tolerance - readysaltedcode story">
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/stories">Stories</a>
      </nav>
      <h1>Global Movements dance, data & cultural tolerance</h1>
    </div>
  </section>

  <article class="story-content">
    <div class="container">
      <p>Sat 22 Apr to Wed 31 May 2017</p>
      <p>A mixture of dance and visual arts, this project was initiated by the young people working with Aik Saath. Running from January to March 2017, with the help from us at ReadySaltedCode, this project created a piece of visual art, mapping different dances that represent Slough’s diverse communities.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 3rem 0;
  }
  .breadcrumb { margin-bottom: 1rem; }
  .breadcrumb a { color: #ccc; }
  .page-header h1 { color: #fff; margin-bottom: 0.5rem; }
  .story-content { padding: 3rem 0; }
  .story-content .container { max-width: 800px; }
  .story-content p { margin-bottom: 1.5rem; line-height: 1.8; }
  .story-content img { max-width: 100%; height: auto; margin: 1.5rem 0; border-radius: 8px; }
  .story-content a { color: #dd3333; }
  .story-content blockquote { border-left: 4px solid #dd3333; padding-left: 1.5rem; margin: 1.5rem 0; font-style: italic; color: #555; }
  .story-content strong { font-weight: 600; }
</style>
