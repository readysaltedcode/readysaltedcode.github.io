---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="RPi-ano | RPi + Momentary Push Buttons" description="RPi-ano | RPi + Momentary Push Buttons - readysaltedcode story">
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/stories">Stories</a>
      </nav>
      <h1>RPi-ano | RPi + Momentary Push Buttons</h1>
    </div>
  </section>

  <article class="story-content">
    <div class="container">
      <p><a href="https://flic.kr/p/pVvhwJ"><img loading="lazy" src="https://farm8.staticflickr.com/7516/15701693806_ef82c65ebc_c.jpg" alt="Rpi-ano 5 buttons" width="600" height="800" /></a></p>
      <p><a href="https://flic.kr/p/pVv7kG"><img loading="lazy" src="https://farm4.staticflickr.com/3946/15701659526_deb6c26788_z.jpg" alt="RPi-ano wiring diagram" width="640" height="406" /></a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 3rem 0;
  }
  .breadcrumb { margin-bottom: 1rem; }
  .breadcrumb a { color: #ccc; }
  .page-header h1 { color: #fff; margin-bottom: 0.5rem; }
  .story-content { padding: 3rem 0; }
  .story-content .container { max-width: 800px; }
  .story-content p { margin-bottom: 1.5rem; line-height: 1.8; }
  .story-content img { max-width: 100%; height: auto; margin: 1.5rem 0; border-radius: 8px; }
  .story-content a { color: #dd3333; }
  .story-content blockquote { border-left: 4px solid #dd3333; padding-left: 1.5rem; margin: 1.5rem 0; font-style: italic; color: #555; }
  .story-content strong { font-weight: 600; }
</style>
