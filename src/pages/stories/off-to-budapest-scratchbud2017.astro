---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Off to Budapest ScratchBUD2017" description="Off to Budapest ScratchBUD2017 - readysaltedcode story">
  <section class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/stories">Stories</a>
      </nav>
      <h1>Off to Budapest ScratchBUD2017</h1>
    </div>
  </section>

  <article class="story-content">
    <div class="container">
      <p>We are really excited as Genevieve gave a keynote at #ScratchBUD2017 on our datadrivendance project and specifically spoke about [pain]byte. #ScratchBUD2017.</p>
      <p><iframe src="https://www.youtube.com/embed/cvjgf0hWUk4?start=1550" width="560" height="315" frameborder="0" allowfullscreen="allowfullscreen"></iframe></p>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 3rem 0;
  }
  .breadcrumb { margin-bottom: 1rem; }
  .breadcrumb a { color: #ccc; }
  .page-header h1 { color: #fff; margin-bottom: 0.5rem; }
  .story-content { padding: 3rem 0; }
  .story-content .container { max-width: 800px; }
  .story-content p { margin-bottom: 1.5rem; line-height: 1.8; }
  .story-content img { max-width: 100%; height: auto; margin: 1.5rem 0; border-radius: 8px; }
  .story-content a { color: #dd3333; }
  .story-content blockquote { border-left: 4px solid #dd3333; padding-left: 1.5rem; margin: 1.5rem 0; font-style: italic; color: #555; }
  .story-content strong { font-weight: 600; }
</style>
