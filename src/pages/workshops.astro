---
import BaseLayout from '../layouts/BaseLayout.astro';

const trainingOptions = [
  {
    title: 'Hackday Methodology Training',
    duration: 'Full day',
    price: 'From £450',
    capacity: 'Up to 20 educators',
    description: 'Learn how to run creative computing hackdays at your school. We teach you the methodology so you can deliver engaging hackdays year after year.',
    includes: [
      'Complete hackday framework',
      'Challenge design templates',
      'Facilitation techniques',
      'All resources to run your own events'
    ],
    suitable: 'Computing leads, STEM coordinators',
    featured: true
  },
  {
    title: 'Wearables for Educators',
    duration: 'Half day',
    price: 'From £300',
    capacity: 'Up to 15 educators',
    description: 'Build your confidence with wearable technology. Learn how to teach sewable circuits, LEDs, and e-textiles in your classroom.',
    includes: [
      'Hands-on making experience',
      'Complete lesson resources',
      'Troubleshooting guide',
      'Kit recommendations'
    ],
    suitable: 'Primary & Secondary teachers',
    featured: false
  },
  {
    title: 'datadrivendance for Schools',
    duration: 'Full day',
    price: 'From £500',
    capacity: 'Up to 15 educators',
    description: 'Learn how to run your own data-driven dance event. Combine computing with PE/Dance for a cross-curricular project that culminates in a school performance.',
    includes: [
      'Complete methodology framework',
      'Session-by-session plans',
      'Technical setup guides',
      'Performance event checklist'
    ],
    suitable: 'Computing & PE teachers, STEM leads',
    featured: true
  },
  {
    title: 'Physical Computing Fundamentals',
    duration: 'Half day',
    price: 'From £300',
    capacity: 'Up to 15 educators',
    description: 'Get confident with micro:bit, Raspberry Pi, or Arduino. Practical training so you can teach physical computing with confidence.',
    includes: [
      'Platform deep-dive',
      'Project-based learning approach',
      'Classroom management tips',
      'Lesson resources included'
    ],
    suitable: 'Primary & Secondary teachers',
    featured: false
  },
  {
    title: 'Bespoke Training',
    duration: 'Flexible',
    price: 'By arrangement',
    capacity: 'Flexible',
    description: 'Need something specific? We design training around your school\'s needs, curriculum, and equipment.',
    includes: [
      'Needs analysis consultation',
      'Customised training programme',
      'Tailored resources',
      'Follow-up support'
    ],
    suitable: 'Schools, MATs, Education authorities',
    featured: false
  }
];

const testimonials = [
  {
    quote: "The training gave us everything we needed to run hackdays ourselves. We've now done three and the students love them.",
    author: "Head of Computing",
    school: "Secondary Academy, Brighton"
  },
  {
    quote: "The datadrivendance methodology was brilliant. Our PE and Computing departments collaborated for the first time, and the performance event was a highlight of the school year.",
    author: "STEM Coordinator",
    school: "Primary School, London"
  }
];
---

<BaseLayout title="Training" description="Educator training for creative computing - learn methodologies you can deliver yourself">
  <section class="page-header">
    <div class="container">
      <h1>Training for Educators</h1>
      <p class="subtitle">Learn methodologies you can deliver in your school, year after year</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <div class="container">
      <div class="intro-content">
        <h2>Build Your Creative Computing Toolkit</h2>
        <p>Our training empowers you to run engaging creative computing activities yourself. Developed by Dr. Genevieve Smith-Nunes - who helped shape the UK's national computing curriculum - each methodology is research-backed and classroom-tested. You'll leave with everything you need to deliver confidently.</p>
        <div class="stats">
          <div class="stat">
            <span class="number">100+</span>
            <span class="label">Educators Trained</span>
          </div>
          <div class="stat">
            <span class="number">50+</span>
            <span class="label">Schools Supported</span>
          </div>
          <div class="stat">
            <span class="number">15+</span>
            <span class="label">Years Experience</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Training Options -->
  <section class="workshops">
    <div class="container">
      <h2>Training Options</h2>

      <div class="workshops-grid">
        {trainingOptions.map((training) => (
          <div class={`workshop-card ${training.featured ? 'featured' : ''}`}>
            {training.featured && <span class="featured-badge">Popular</span>}
            <div class="workshop-header">
              <h3>{training.title}</h3>
              <div class="workshop-meta">
                <span class="duration">{training.duration}</span>
                <span class="price">{training.price}</span>
              </div>
            </div>
            <p class="description">{training.description}</p>
            <div class="capacity">
              <strong>Group size:</strong> {training.capacity}
            </div>
            <div class="suitable">
              <strong>For:</strong> {training.suitable}
            </div>
            <div class="includes">
              <strong>You'll get:</strong>
              <ul>
                {training.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <a href="#enquire" class="enquire-btn">Enquire</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works">
    <div class="container">
      <h2>How It Works</h2>
      <div class="steps">
        <div class="step">
          <span class="step-number">1</span>
          <h3>Get in Touch</h3>
          <p>Tell us about your school, staff, and what you'd like to be able to deliver.</p>
        </div>
        <div class="step">
          <span class="step-number">2</span>
          <h3>We Design Together</h3>
          <p>We'll tailor the training to your curriculum, equipment, and experience level.</p>
        </div>
        <div class="step">
          <span class="step-number">3</span>
          <h3>Training Day</h3>
          <p>Hands-on, practical training where you'll actually do the activities you'll be teaching.</p>
        </div>
        <div class="step">
          <span class="step-number">4</span>
          <h3>Deliver Confidently</h3>
          <p>You have everything you need - resources, guides, and ongoing support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials">
    <div class="container">
      <h2>What Schools Say</h2>
      <div class="testimonials-grid">
        {testimonials.map((testimonial) => (
          <blockquote class="testimonial">
            <p>"{testimonial.quote}"</p>
            <footer>
              <strong>{testimonial.author}</strong>
              <span>{testimonial.school}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Travel -->
  <section class="travel">
    <div class="container">
      <h2>Travel & Logistics</h2>
      <div class="travel-info">
        <div class="travel-item">
          <h3>Within 50 miles</h3>
          <p>Travel included in workshop price</p>
        </div>
        <div class="travel-item">
          <h3>50-100 miles</h3>
          <p>+£50 travel supplement</p>
        </div>
        <div class="travel-item">
          <h3>100+ miles</h3>
          <p>+£100 (or +£150 with overnight stay)</p>
        </div>
      </div>
      <p class="travel-note">We're based in the South East but travel nationwide. International workshops by arrangement.</p>
    </div>
  </section>

  <!-- Enquiry Form -->
  <section class="enquire" id="enquire">
    <div class="container">
      <h2>Enquire About Training</h2>
      <p>Ready to empower your educators? Get in touch to discuss training options for your school or MAT.</p>

      <div class="enquiry-options">
        <a href="mailto:genevieve@readysaltedcode.org?subject=Training Enquiry" class="enquiry-btn primary">
          Email Us
        </a>
      </div>

      <p class="response-time">We typically respond within 2 working days.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .page-header h1 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #ccc;
    font-size: 1.2rem;
    margin: 0;
  }

  /* Intro */
  .intro {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .intro-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .intro h2 {
    margin-bottom: 1rem;
  }

  .intro p {
    color: #555;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat .number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: #dd3333;
  }

  .stat .label {
    color: #666;
    font-size: 0.9rem;
  }

  /* Workshops */
  .workshops {
    padding: 4rem 0;
  }

  .workshops h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .workshops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .workshop-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.5rem;
    position: relative;
    transition: box-shadow 0.2s;
  }

  .workshop-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .workshop-card.featured {
    border-color: #dd3333;
  }

  .featured-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    background: #dd3333;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .workshop-header {
    margin-bottom: 1rem;
  }

  .workshop-header h3 {
    margin-bottom: 0.5rem;
  }

  .workshop-meta {
    display: flex;
    gap: 1rem;
  }

  .workshop-meta .duration {
    background: #f0f0f0;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .workshop-meta .price {
    font-weight: 700;
    color: #dd3333;
    font-size: 1.1rem;
  }

  .workshop-card .description {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .workshop-card .capacity,
  .workshop-card .suitable {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    color: #666;
  }

  .workshop-card .includes {
    margin: 1rem 0;
  }

  .workshop-card .includes strong {
    font-size: 0.9rem;
  }

  .workshop-card .includes ul {
    margin: 0.5rem 0 0 1.25rem;
    padding: 0;
    font-size: 0.85rem;
    color: #666;
  }

  .workshop-card .includes li {
    margin-bottom: 0.25rem;
  }

  .enquire-btn {
    display: block;
    text-align: center;
    background: #dd3333;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 1rem;
    transition: background 0.2s;
  }

  .enquire-btn:hover {
    background: #bb2222;
  }

  /* How It Works */
  .how-it-works {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .how-it-works h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .step {
    text-align: center;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: #dd3333;
    color: #fff;
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .step h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .step p {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
  }

  /* Testimonials */
  .testimonials {
    padding: 4rem 0;
  }

  .testimonials h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .testimonial {
    background: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #dd3333;
    margin: 0;
  }

  .testimonial p {
    font-style: italic;
    color: #555;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .testimonial footer {
    font-size: 0.9rem;
  }

  .testimonial footer strong {
    display: block;
    color: #333;
  }

  .testimonial footer span {
    color: #888;
  }

  /* Travel */
  .travel {
    padding: 3rem 0;
    background: #1a1a2e;
    color: #fff;
  }

  .travel h2 {
    text-align: center;
    color: #fff;
    margin-bottom: 2rem;
  }

  .travel-info {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .travel-item {
    text-align: center;
    min-width: 150px;
  }

  .travel-item h3 {
    color: #dd3333;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .travel-item p {
    margin: 0;
    opacity: 0.9;
    font-size: 0.9rem;
  }

  .travel-note {
    text-align: center;
    opacity: 0.8;
    font-size: 0.9rem;
    margin: 1rem 0 0 0;
  }

  /* Enquire */
  .enquire {
    padding: 4rem 0;
    text-align: center;
  }

  .enquire h2 {
    margin-bottom: 0.5rem;
  }

  .enquire > p {
    color: #666;
    margin-bottom: 2rem;
  }

  .enquiry-options {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .enquiry-btn {
    padding: 0.75rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .enquiry-btn.primary {
    background: #dd3333;
    color: #fff;
  }

  .enquiry-btn.primary:hover {
    background: #bb2222;
  }

  .enquiry-btn.secondary {
    background: #fff;
    color: #333;
    border: 2px solid #333;
  }

  .enquiry-btn.secondary:hover {
    background: #333;
    color: #fff;
  }

  .or {
    color: #888;
    margin: 0;
  }

  .response-time {
    color: #888;
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .workshops-grid {
      grid-template-columns: 1fr;
    }

    .stats {
      gap: 2rem;
    }
  }
</style>
