---
import BaseLayout from '../layouts/BaseLayout.astro';

const performances = [
  {
    title: '[arra]stre',
    description: 'A data-driven dance performance exploring the historical gold mining process of arrastre, translated into movement and technology.',
    year: '2014',
    image: '/images/1/Arrestre_logo_Large.png',
    awards: ['Arts Council England Grant', 'Google RISE Award']
  },
  {
    title: '[data]storm',
    description: 'An immersive performance piece combining live dance with real-time data visualization, exploring themes of digital chaos and human connection.',
    year: '2015',
    image: '/images/1/data_storm2.png',
    awards: ['Brighton Digital Festival']
  },
  {
    title: '[pain]Byte',
    description: 'A VR ballet exploring chronic pain through biometric data, wearable technology, and classical dance. Transforming invisible pain into visible digital art.',
    year: '2016-present',
    image: '/images/1/DataStorm-moodboard-copy.jpg',
    awards: ['Arts Council England Grant']
  }
];
---

<BaseLayout title="datadrivendance" description="A proven methodology combining dance, data, and computing education">
  <section class="page-header">
    <div class="container">
      <h1><span class="accent">datadrivendance</span></h1>
      <p class="subtitle">A methodology for schools: where data meets dance, technology meets art</p>
    </div>
  </section>

  <section class="intro">
    <div class="container">
      <div class="intro-content">
        <p>
          datadrivendance is a proven methodology that combines data, wearable technology,
          and movement to create engaging cross-curricular learning experiences. Originally
          developed through award-winning performance pieces, it's now available as a
          complete framework for schools.
        </p>
        <p>
          Run your own datadrivendance event - combining Computing and PE/Dance curricula
          in a project that culminates in a school performance. No dance expertise required.
        </p>
      </div>
    </div>
  </section>

  <!-- For Schools Section -->
  <section class="for-schools">
    <div class="container">
      <h2>datadrivendance for Schools</h2>
      <div class="package-info">
        <div class="package-description">
          <p>Everything you need to run a cross-curricular data and dance project at your school, ending in a live performance event.</p>
          <ul>
            <li>8-12 session framework (flexible to your timetable)</li>
            <li>Complete lesson plans for Computing and PE/Dance</li>
            <li>Data collection activities (age-appropriate, ethical)</li>
            <li>Movement/choreography resources (no dance expertise needed)</li>
            <li>Technical setup guides for data visualisation</li>
            <li>Performance event planning checklist</li>
            <li>Student workbooks and assessment criteria</li>
          </ul>
        </div>
        <div class="package-cta">
          <p><strong>Interested in running datadrivendance at your school?</strong></p>
          <a href="/workshops" class="btn">Explore Training Options</a>
          <p class="or">or</p>
          <a href="mailto:genevieve@readysaltedcode.org?subject=datadrivendance%20for%20Schools" class="btn-secondary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="performances">
    <div class="container">
      <h2>The Original Performances</h2>
      <p class="performances-intro">datadrivendance began as a series of award-winning performance pieces. These works informed the methodology now available to schools.</p>
      {performances.map((performance) => (
        <article class="performance-card">
          <div class="performance-image">
            {performance.image && <img src={performance.image} alt={performance.title} />}
          </div>
          <div class="performance-content">
            <div class="performance-header">
              <h3>{performance.title}</h3>
              <span class="year">{performance.year}</span>
            </div>
            <p>{performance.description}</p>
            {performance.awards && performance.awards.length > 0 && (
              <div class="awards">
                {performance.awards.map((award) => (
                  <span class="award">{award}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Bring datadrivendance to Your School</h2>
      <p>Ready to run a cross-curricular project that combines computing, data, and movement? Get trained on the methodology or get in touch to discuss options.</p>
      <div class="cta-buttons">
        <a href="/workshops" class="btn">Explore Training</a>
        <a href="mailto:genevieve@readysaltedcode.org?subject=datadrivendance%20enquiry" class="btn-outline">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .page-header h1 {
    color: #fff;
    font-size: 3rem;
  }

  .page-header .accent {
    color: #dd3333;
  }

  .subtitle {
    color: #ccc;
    font-size: 1.2rem;
    margin: 0;
  }

  .intro {
    padding: 3rem 0;
    background: #f9f9f9;
  }

  .intro-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .intro-content p {
    font-size: 1.1rem;
    color: #555;
  }

  .performances {
    padding: 3rem 0;
  }

  .performances h2 {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .performance-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2rem;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
  }

  .performance-image {
    background: #1a1a2e;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    min-height: 200px;
  }

  .performance-image img {
    max-width: 100%;
    max-height: 200px;
    object-fit: contain;
  }

  .performance-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .performance-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .performance-header h3 {
    margin: 0;
    color: #dd3333;
    font-size: 1.8rem;
  }

  .year {
    color: #999;
    font-size: 0.9rem;
  }

  .performance-content p {
    color: #666;
    margin-bottom: 1rem;
  }

  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .award {
    background: #dd3333;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 15px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .cta {
    padding: 4rem 0;
    background: #f9f9f9;
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 1rem;
  }

  .cta p {
    color: #666;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    background: #dd3333;
    color: #fff;
    border-radius: 4px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .btn:hover {
    background: #bb2222;
    color: #fff;
  }

  .btn-outline {
    display: inline-block;
    padding: 1rem 2rem;
    background: transparent;
    color: #dd3333;
    border: 2px solid #dd3333;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline:hover {
    background: #dd3333;
    color: #fff;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: #dd3333;
    border: 1px solid #dd3333;
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: #dd3333;
    color: #fff;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* For Schools Section */
  .for-schools {
    padding: 4rem 0;
    background: #fff;
  }

  .for-schools h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .package-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    max-width: 900px;
    margin: 0 auto;
  }

  .package-description p {
    color: #555;
    margin-bottom: 1.5rem;
  }

  .package-description ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .package-description li {
    padding: 0.5rem 0;
    color: #555;
    border-bottom: 1px solid #eee;
  }

  .package-description li:before {
    content: '✓';
    color: #28a745;
    margin-right: 0.75rem;
    font-weight: bold;
  }

  .package-cta {
    background: #f9f9f9;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .package-cta p {
    margin-bottom: 1rem;
  }

  .package-cta .or {
    color: #888;
    font-size: 0.9rem;
    margin: 0.75rem 0;
  }

  .package-cta .btn {
    display: block;
    margin-bottom: 0;
  }

  .performances-intro {
    text-align: center;
    color: #666;
    max-width: 700px;
    margin: 0 auto 2rem auto;
  }

  @media (max-width: 768px) {
    .package-info {
      grid-template-columns: 1fr;
    }
  }
    .performance-card {
      grid-template-columns: 1fr;
    }

    .performance-image {
      min-height: 150px;
    }

    .page-header h1 {
      font-size: 2rem;
    }
  }
</style>
