---
import BaseLayout from '../layouts/BaseLayout.astro';

const lessonPacks = [
  {
    title: 'Wearables with Gemma',
    description: 'Complete lesson pack for creating wearable technology with Adafruit Gemma and NeoPixels. Includes teacher guide, student worksheets, and assessment rubrics.',
    lessons: '6 lessons',
    level: 'KS2-3',
    tags: ['Wearables', 'Physical Computing'],
    link: '/lessons/gemma'
  },
  {
    title: 'Simple Sewable Circuits',
    description: 'Introduction to e-textiles and sewable electronics. Perfect for beginners and cross-curricular projects with textiles/DT.',
    lessons: '4 lessons',
    level: 'KS2-3',
    tags: ['Wearables', 'Beginner'],
    link: '/lessons/simple-wearables'
  },
  {
    title: 'RPi-ano: GPIO Piano',
    description: 'Build an interactive piano using Raspberry Pi and GPIO. Covers inputs, outputs, and Python programming.',
    lessons: '5 lessons',
    level: 'KS3-4',
    tags: ['Raspberry Pi', 'Python'],
    link: '/lessons/rpi-ano'
  },
  {
    title: 'Crumble Computing',
    description: 'Getting started with the Crumble board. Block-based programming for physical computing.',
    lessons: '4 lessons',
    level: 'KS1-2',
    tags: ['Crumble', 'Beginner'],
    link: '/lessons/crumble'
  },
  {
    title: 'Piano Glove Project',
    description: 'Advanced wearable musical instrument using Flora, audio codec, and color sensors. Includes cross-curricular music and art links.',
    lessons: '6+ lessons',
    level: 'KS3-4',
    tags: ['Wearables', 'Advanced', 'Music'],
    link: '/lessons/piano-glove'
  },
  {
    title: 'RC Car with AppShed',
    description: 'Build and program a remote-controlled car with mobile app control. Great for robotics clubs.',
    lessons: '5 lessons',
    level: 'KS3-4',
    tags: ['Robotics', 'Mobile Apps'],
    link: '/lessons/rc-car'
  }
];
---

<BaseLayout title="Resources" description="Free creative computing resources for educators">
  <section class="page-header">
    <div class="container">
      <h1>Free Educator Resources</h1>
      <p class="subtitle">Ready-to-teach creative computing lesson packs - free for educators</p>
    </div>
  </section>

  <!-- Lesson Packs Section -->
  <section class="lesson-packs">
    <div class="container">
      <div class="section-header">
        <span class="badge free">Free</span>
        <h2>Lesson Packs</h2>
        <p>Complete, ready-to-teach lesson packs with everything you need. Updated for modern hardware in January 2026.</p>
      </div>

      <div class="packs-grid">
        {lessonPacks.map((pack) => (
          <div class="pack-card">
            <div class="pack-header">
              <div class="tags">
                {pack.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="free-badge">Free</span>
            </div>
            <h3>{pack.title}</h3>
            <p>{pack.description}</p>
            <div class="pack-meta">
              <span>{pack.lessons}</span>
              <span>{pack.level}</span>
            </div>
            <a href={pack.link} class="view-btn">View Lessons</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="included">
    <div class="container">
      <h2>What's Included</h2>
      <div class="included-grid">
        <div class="included-item">
          <h3>Detailed Lesson Plans</h3>
          <p>Step-by-step teacher guides with learning objectives, differentiation, and timing.</p>
        </div>
        <div class="included-item">
          <h3>Student Worksheets</h3>
          <p>Engaging activities and worksheets ready to print or share digitally.</p>
        </div>
        <div class="included-item">
          <h3>Editable Resources</h3>
          <p>Word and PowerPoint files you can customise for your school.</p>
        </div>
        <div class="included-item">
          <h3>Assessment Materials</h3>
          <p>Rubrics, success criteria, and exemplar work to support assessment.</p>
        </div>
        <div class="included-item">
          <h3>Curriculum Mapping</h3>
          <p>Clear links to National Curriculum computing objectives.</p>
        </div>
        <div class="included-item">
          <h3>Educator Support</h3>
          <p>Video tutorials and guides to build your confidence with new topics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Training CTA -->
  <section class="contact" id="contact">
    <div class="container">
      <h2>Want More?</h2>
      <p>Looking for training on how to deliver these lessons confidently? We offer educator training sessions.</p>
      <div class="cta-buttons">
        <a href="/workshops" class="contact-btn">Explore Training</a>
        <a href="mailto:genevieve@readysaltedcode.org" class="contact-btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .page-header h1 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #ccc;
    font-size: 1.2rem;
    margin: 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: #666;
    max-width: 600px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    background: #28a745;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  /* Lesson Packs */
  .lesson-packs {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .packs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .pack-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }

  .pack-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .pack-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .pack-header .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .pack-header .tag {
    background: #f0f0f0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #666;
  }

  .free-badge {
    background: #28a745;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .pack-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .pack-card > p {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .pack-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .view-btn {
    display: block;
    text-align: center;
    background: #dd3333;
    color: #fff;
    padding: 0.6rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }

  .view-btn:hover {
    background: #bb2222;
  }

  /* What's Included */
  .included {
    padding: 4rem 0;
  }

  .included h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .included-item {
    text-align: center;
    padding: 1rem;
  }

  .included-item h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: #dd3333;
  }

  .included-item p {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
  }

  /* Contact */
  .contact {
    padding: 4rem 0;
    background: #1a1a2e;
    color: #fff;
    text-align: center;
  }

  .contact h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .contact p {
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-btn {
    display: inline-block;
    background: #dd3333;
    color: #fff;
    padding: 0.75rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s;
  }

  .contact-btn:hover {
    background: #bb2222;
  }

  .contact-btn-outline {
    display: inline-block;
    background: transparent;
    color: #fff;
    padding: 0.75rem 2rem;
    border-radius: 4px;
    border: 2px solid #fff;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .contact-btn-outline:hover {
    background: #fff;
    color: #1a1a2e;
  }

  @media (max-width: 768px) {
    .packs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
